# Local settings for the server (copy to server/.env; that file is gitignored). On Render, set these
# in the dashboard (service → Environment), never in render.yaml or the repository.
#
# JWT_SECRET=…                  signing secret for login tokens
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=…              12+ characters in production
#
# AI suggestions for open answers (wish 7, layer B). OFF unless AI_GRADING_ENABLED is set AND a
# quiz has "AI suggestions for free-text answers" ticked. Needs the DPO's written approval first.
# AI_GRADING_ENABLED=true
# GEMINI_API_KEY=…              Google Gemini API key (paid tier); never commit it
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# AI_GRADING_CONCURRENCY=4
# AI_MAX_CALLS_PER_DAY=3000
# AI_GRADING_TIMEOUT_MS=60000
# AI_GRADING_PROVIDER=fake      local tests only: a deterministic stand-in, refused in production
# AI_FAKE_LATENCY_MS=800        fake provider only: simulated latency
